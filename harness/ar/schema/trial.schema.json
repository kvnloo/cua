{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ar.trial.v1",
  "title": "One raw trial row (runner/caller.py), one fresh sandboxed Driver",
  "type": "object",
  "required": ["schema", "trial_id", "session", "pair_id", "order", "position", "arm", "kind", "trace",
               "warmup", "binary_sha256", "t_spawn_ns", "verified", "claimed_success", "failure",
               "journal", "calls", "dispatch_calls", "loadavg_start", "loadavg_end"],
  "properties": {
    "schema": {"const": "ar.trial.v1"},
    "eval_id": {"type": "string"},
    "trial_id": {"type": "integer", "minimum": 0},
    "session": {"type": "integer", "minimum": 0},
    "pair_id": {"type": ["integer", "string", "null"]},
    "order": {"enum": ["AB", "BA", null]},
    "position": {"type": ["integer", "null"]},
    "arm": {"enum": ["champion", "candidate"]},
    "kind": {"enum": ["task", "soak", "stale_negative", "impossible_canary", "spot_gtk3_text", "spot_browser_fill_submit"]},
    "trace": {"type": "boolean"},
    "warmup": {"type": "boolean"},
    "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "t_spawn_ns": {"type": "integer", "description": "CLOCK_MONOTONIC just before the Driver is spawned"},
    "t_init_ns": {"type": "integer"},
    "t_done_ns": {"type": "integer", "description": "CLOCK_MONOTONIC at the caller's oracle-verified done"},
    "T_ns": {"type": "integer", "description": "t_done_ns - t_spawn_ns"},
    "t_exit_ns": {"type": "integer"},
    "mutation_mono_est_ns": {"type": "integer"},
    "journal_before_done": {"type": "boolean"},
    "verified": {"type": "boolean"},
    "claimed_success": {"type": ["boolean", "null"]},
    "failure": {"type": ["string", "null"]},
    "refused": {"type": "boolean"},
    "refusal_code": {"type": ["string", "null"]},
    "refused_stale": {"type": "boolean"},
    "canary_outcome": {"enum": ["refused", "unknown", "claimed_success"]},
    "seq_delta": {"type": "integer"},
    "before": {"type": "object"},
    "after": {"type": "object"},
    "expected": {"type": "object"},
    "journal": {"type": "array"},
    "calls": {"type": "array"},
    "dispatch_calls": {"type": "integer"},
    "route": {"type": ["string", "null"]},
    "path": {"type": ["string", "null"]},
    "footprint": {
      "type": "object",
      "required": ["procs", "sockets", "fds", "home_files"],
      "properties": {
        "procs": {"type": "integer"},
        "sockets": {"type": "integer"},
        "fds": {"type": "integer"},
        "home_files": {"type": "array", "items": {"type": "string"}}
      }
    },
    "marks": {"type": "array"},
    "observations": {"type": "array"},
    "psi": {"type": "object"},
    "loadavg_start": {"type": "array"},
    "loadavg_end": {"type": "array"}
  }
}
