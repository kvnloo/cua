+function runScenario(scenario: Scenario = {}) {
+  const directory = mkdtempSync(join(tmpdir(), 'jev-guarded-run-'));
+  try {
+    const log = join(directory, 'events.jsonl');
+    const child = spawnSync(
+      process.execPath,
