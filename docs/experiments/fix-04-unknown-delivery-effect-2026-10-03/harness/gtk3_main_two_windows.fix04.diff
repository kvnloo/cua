         root.pack_start(self.button("Exit", lambda *_: Gtk.main_quit()), False, False, 0)
         self.connect("destroy", Gtk.main_quit if shared is None else self.on_closed)
+        # FIX-04 (measurement only, two-window mode only): CUA_GTK3_FOCUS_STATE=1 also publishes each
+        # window's focused widget (its label or accessible name) and whether the window is active, so a
+        # GrabFocus that lands in the wrong window is target-observed.
+        self.focus_state = shared is not None and os.environ.get("CUA_GTK3_FOCUS_STATE") == "1"
+        if self.focus_state:
+            self.connect("set-focus", lambda *_: GLib.idle_add(self.publish_once))
+            self.connect("notify::is-active", lambda *_: GLib.idle_add(self.publish_once))
         self.publish()
 
+    def publish_once(self):
+        if self.open:
+            self.publish()
+        return GLib.SOURCE_REMOVE
+
+    def focus_name(self):
+        widget = self.get_focus()
+        if widget is None:
+            return None
+        label = widget.get_label() if hasattr(widget, "get_label") else None
+        return label or widget.get_accessible().get_name() or type(widget).__name__
+
